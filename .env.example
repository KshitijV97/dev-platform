# Copy to .env and fill in. Never commit .env.
DOMAIN=example.com
TZ=America/Toronto

# Application image built by CI and pushed to GHCR.
# Leave empty to use the nginx placeholder in compose/compose.yaml.
APP_IMAGE=

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# External monitoring (optional in local development)
HEALTHCHECKS_PING_URL=
SENTRY_DSN=

# Backups (OCI Object Storage is S3-compatible; values from the console)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
