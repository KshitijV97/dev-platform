# Environment
.env
.env.*
!.env.example

# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Real variable files carry the SSH public key, your home CIDR, and the
# Tailscale auth key. Only the example may be committed.
*.tfvars
*.tfvars.json
*.auto.tfvars
!*.tfvars.example
!*.tfvars.json.example

# Secrets and keys
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Backups and local data
backups/
*.sql.gz
*.dump

# Tracker exports (contain issue bodies; back them up, do not commit them)
exports/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node (for future tooling)
node_modules/
npm-debug.log*
