# Copy to terraform.tfvars and fill in. Never commit the result.
oci_profile      = "DEFAULT"
tenancy_ocid     = "ocid1.tenancy.oc1..example"
compartment_ocid = "ocid1.compartment.oc1..example"
region           = "ca-toronto-1"

ssh_public_key   = "ssh-ed25519 AAAA... you@example"
ssh_allowed_cidr = "203.0.113.10/32"

deploy_user = "deploy"

# Optional. Create a single-use, pre-authorized key in Tailscale.
tailscale_auth_key = ""
